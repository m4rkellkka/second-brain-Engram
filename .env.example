# Copy to .env.local and adjust. Public vars are validated in src/lib/env.ts,
# server-only vars in src/server/env.ts.

# Supabase project URL and publishable key (public).
# Local stack defaults below; get them with `pnpm db:status`.
# Cloud: Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-only. Comma-separated emails allowed to sign in to this instance.
# Sign-up is disabled: create the account in the Supabase dashboard
# (Authentication -> Users -> Add user, "Auto confirm"). Locally the seed
# creates dev@engram.local with the password `engram-dev`.
ALLOWED_EMAILS=dev@engram.local
